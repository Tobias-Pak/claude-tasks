{
  "name": "claude-tasks",
  "version": "0.1.0",
  "description": "A per-repo task list that lives inside Claude, exposed as an MCP server.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-tasks": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tobias-Pak/claude-tasks.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
